# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
PORT=3000

DB_HOST=localhost
# Aiven ใช้พอร์ตของตัวเอง ดูในหน้า service
DB_PORT=3306
DB_USER=rice
DB_PASSWORD=
DB_NAME=rice_dispatch

# Aiven ตั้งเป็น true แล้วใส่ใบรับรอง CA ใน DB_CA
DB_SSL=false
DB_CA=

# ต้องตรงทุกตัวอักษร ไม่มี / ปิดท้าย คั่นด้วย ,
CORS_ORIGINS=http://localhost:4200,https://<ชื่อโปรเจกต์>.vercel.app
